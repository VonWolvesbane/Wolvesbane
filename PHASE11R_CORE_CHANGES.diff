+		// Wolvesbane save profiling (Phase 11)
+		public static bool WBSaveProfileEnabled = true;
+
+		private static readonly object m_WBSaveProfileSync = new object();
+		private static Dictionary<string, double> m_WBSaveProfileStages = new Dictionary<string, double>();
+
+		internal static void WBResetSaveProfile()
+		{
+			lock (m_WBSaveProfileSync)
+			{
+				m_WBSaveProfileStages.Clear();
+			}
+		}
+
+		internal static void WBReportSaveStage(string name, TimeSpan elapsed)
+		{
+			if (!WBSaveProfileEnabled)
+				return;
+
+			lock (m_WBSaveProfileSync)
+			{
+				double existing;
+
+				if (!m_WBSaveProfileStages.TryGetValue(name, out existing))
+					existing = 0.0;
+
+				m_WBSaveProfileStages[name] = existing + elapsed.TotalMilliseconds;
+			}
+		}
+
+		private static double WBGetSaveStage(string name)
+		{
+			lock (m_WBSaveProfileSync)
+			{
+				double value;
+				return m_WBSaveProfileStages.TryGetValue(name, out value) ? value : 0.0;
+			}
+		}
+
+		private static void WBPrintSaveProfile(string strategyName, double displayedSaveMilliseconds)
+		{
+			if (!WBSaveProfileEnabled)
+				return;
+
+			double strategy = WBGetSaveStage("Strategy");
+			double mobiles = WBGetSaveStage("Mobiles");
+			double items = WBGetSaveStage("Items");
+			double guilds = WBGetSaveStage("Guilds");
+			double data = WBGetSaveStage("CustomData");
+			double worldSaveEvent = WBGetSaveStage("WorldSaveEvent");
+			double before = WBGetSaveStage("BeforeWorldSave");
+			double flushPause = WBGetSaveStage("NetFlushPause");
+			double wait = WBGetSaveStage("WaitForWriteCompletion");
+
+			Console.WriteLine("WB SAVE PROFILE: strategy={0}, displayed={1:F1}ms, strategy={2:F1}ms, WorldSaveEvent={3:F1}ms",
+				strategyName, displayedSaveMilliseconds, strategy, worldSaveEvent);
+			Console.WriteLine("WB SAVE PROFILE: Items={0:F1}ms, Mobiles={1:F1}ms, Guilds={2:F1}ms, CustomData={3:F1}ms",
+				items, mobiles, guilds, data);
+			Console.WriteLine("WB SAVE PROFILE: BeforeWorldSave={0:F1}ms, NetFlushPause={1:F1}ms, PreviousWriteWait={2:F1}ms",
+				before, flushPause, wait);
+
+			Broadcast(0x3F, true, AccessLevel.Administrator,
+				"WB Profile [{0}] Displayed {1:F1}ms | Strategy {2:F1}ms | WorldSave event {3:F1}ms",
+				strategyName, displayedSaveMilliseconds, strategy, worldSaveEvent);
+
+			if (items > 0.0 || mobiles > 0.0 || guilds > 0.0 || data > 0.0)
+			{
+				Broadcast(0x3F, true, AccessLevel.Administrator,
+					"WB Stages: Items {0:F1}ms | Mobiles {1:F1}ms | Guilds {2:F1}ms | Customs {3:F1}ms",
+					items, mobiles, guilds, data);
+			}
+
+			Broadcast(0x3F, true, AccessLevel.Administrator,
+				"WB Outside displayed timer: BeforeHook {0:F1}ms | NetFlush/Pause {1:F1}ms | PriorWriteWait {2:F1}ms",
+				before, flushPause, wait);
+		}
