+        private static void WBPrintItemTypeProfile(Dictionary<Type, WBItemTypeProfile> profiles, long serializeTicksTotal, TimeSpan itemStage)
+        {
+            if (profiles == null || profiles.Count == 0)
+                return;
+
+            List<WBItemTypeProfile> list = new List<WBItemTypeProfile>(profiles.Values);
+            list.Sort(delegate(WBItemTypeProfile a, WBItemTypeProfile b)
+            {
+                int c = b.SerializeTicks.CompareTo(a.SerializeTicks);
+                if (c != 0)
+                    return c;
+
+                return b.Count.CompareTo(a.Count);
+            });
+
+            double tickToMilliseconds = 1000.0 / (double)Stopwatch.Frequency;
+            double serializeMs = serializeTicksTotal * tickToMilliseconds;
+            double itemMs = itemStage.TotalMilliseconds;
+            double otherMs = itemMs - serializeMs;
+            if (otherMs < 0.0)
+                otherMs = 0.0;
+
+            long totalBytes = 0L;
+            int totalCount = 0;
+            for (int i = 0; i < list.Count; i++)
+            {
+                totalBytes += list[i].Bytes;
+                totalCount += list[i].Count;
+            }
+
+            Console.WriteLine("WB ITEM PROFILE: {0:N0} objects, {1:N0} types, {2:F1} MB data", totalCount, list.Count, totalBytes / (1024.0 * 1024.0));
+            Console.WriteLine("WB ITEM PROFILE: Items stage={0:F1}ms, measured Serialize()={1:F1}ms, other/index/writer/cache~={2:F1}ms", itemMs, serializeMs, otherMs);
+            Console.WriteLine("WB ITEM PROFILE: Top item types by total Serialize() time:");
+
+            int limit = Math.Min(30, list.Count);
+            for (int i = 0; i < limit; i++)
+            {
+                WBItemTypeProfile p = list[i];
+                double ms = p.SerializeTicks * tickToMilliseconds;
+                double avgUs = p.Count > 0 ? (ms * 1000.0) / p.Count : 0.0;
+                double mb = p.Bytes / (1024.0 * 1024.0);
+                double pct = serializeMs > 0.0 ? (ms * 100.0) / serializeMs : 0.0;
+
+                Console.WriteLine("WB ITEM #{0}: {1} | count={2:N0} | serialize={3:F1}ms ({4:F1}%) | avg={5:F2}us | data={6:F2}MB",
+                    i + 1, p.Type.FullName, p.Count, ms, pct, avgUs, mb);
+            }
+
+            // Keep in-game output compact; the console contains the full top 30.
+            World.Broadcast(0x3F, true, AccessLevel.Administrator,
+                "WB Item Profile: {0:N0} items | Serialize {1:F1}ms / Items stage {2:F1}ms | data {3:F1}MB",
+                totalCount, serializeMs, itemMs, totalBytes / (1024.0 * 1024.0));
+
+            int gameLimit = Math.Min(8, list.Count);
+            for (int i = 0; i < gameLimit; i++)
+            {
+                WBItemTypeProfile p = list[i];
+                double ms = p.SerializeTicks * tickToMilliseconds;
+                World.Broadcast(0x3F, true, AccessLevel.Administrator,
+                    "WB Item #{0}: {1} | {2:N0} objs | {3:F1}ms | {4:F2}MB",
+                    i + 1, p.Type.Name, p.Count, ms, p.Bytes / (1024.0 * 1024.0));
             }
